# OpenFactory manifest for an Odoo Community fork — written by `of-odoo register` for project
# '@PROJECT@'. Operator-held by default (<install>/manifests/@PROJECT@.yaml, named by an absolute
# `manifest_path` in the install's registry), so nothing has to be committed to the fork;
# `of-odoo attach --committed` copies it to `.openfactory/project.yaml` instead.
# Reference for every field: core/docs/project.yaml.example.
version: 1

# The Odoo series branch of your fork (16.0 … 20.0, or your own integration branch).
base_branch: "@BASE@"

# A person merges. On the local forge, merging fast-forwards your checkout; `of-odoo update
# <module>` then upgrades the module in the dev database.
merge_policy: human
review_mode: advisory          # the review comments on the PR; it never blocks or loops

# OFF, deliberately. The knowledge map is generated after every merge and published into a
# context repository; on Odoo that is a map of ~600 addons and the framework, which is a lot of
# generation for little gain while the work lives in a handful of custom modules — and with no
# bundle, the knowledge gate would only stamp every PR "dark". Turn both on when you want them.
knowledge_map: false
okf_gate: "off"

# Budgets: where the factory stops and asks instead of spending more.
max_cost_usd: 5.0              # agent spend per ticket (per-token billing; inert on a subscription)
max_diff_lines: 1500           # bigger is a ticket that should have been split

# Before the agent runs: Docker answers, the dev image exists, Postgres is up.
setup:
  - "sh '@OF_ODOO_DIR@/lib/odoo-validate.sh' setup @PROJECT@"

# The real quality floor — the platform runs these itself and reads the exit codes.
validate:
  # Odoo tests of ONLY the addons this change touches (installed into a throwaway database,
  # `--test-tags /<module>`), plus `base` if code outside any addon changed.
  test: "sh '@OF_ODOO_DIR@/lib/odoo-validate.sh' test @PROJECT@"
  # Python/XML/CSV syntax, __manifest__.py shape, access rules for new models — changed files only.
  lint: "sh '@OF_ODOO_DIR@/lib/odoo-validate.sh' lint @PROJECT@"
  # Replaces the platform floor's whole-tree credential scan (the project's declaration wins):
  # Odoo ships test keys and fixtures (base/tests/ssl, account_peppol, ...) that the floor's scan
  # reports on every proof. This one scans the CHANGED files with the same kinds of patterns, and
  # blocks — a credential this change adds is never debt to carry.
  security: "sh '@OF_ODOO_DIR@/lib/odoo-validate.sh' security @PROJECT@"

# One test id per line (`<addon>.tests.<file>.<Class>.<test>`), read statically from every addon
# in the tree — no Odoo run. A drop in the count between the clean tree and the change is gated.
test_inventory: "sh '@OF_ODOO_DIR@/lib/odoo-validate.sh' inventory @PROJECT@"

# A change to the ORM/framework is never "normal": it stays human-gated whatever merge_policy says.
# `stack: odoo` names no shipped preset ON PURPOSE: `stack: python` would add the python preset's
# `mypy .` and `bandit -r .` over the whole Odoo tree, which no Odoo fork passes (measured: both
# missing tools on the proof, and neither is a meaningful gate on 48k files of someone else's code).
components:
  custom_addons:
    path: "custom_addons/**"
    stack: odoo
    risk: normal
  odoo_addons:
    path: "addons/**"
    stack: odoo
    risk: normal
  framework:
    path: "odoo/**"
    stack: odoo
    risk: high

# The agent's Odoo house rules are the deployment's (OPENFACTORY_GUIDELINES_DIR =
# <install>/guidelines, set by of-odoo), so they apply to every fork this install drives without
# being committed to any of them. Project-specific rules can be added here:
# docs:
#   guidelines: [.openfactory/guidelines/house-rules.md]
